cc_library_headers {
    name: "libdiag_headers",
    vendor_available: true,
    export_include_dirs: ["include"],
}

cc_library_shared {
    name: "libdiag",
    vendor: true,
    srcs: ["src/diag_compat.c"],
    header_libs: ["libdiag_headers"],
    export_header_lib_headers: ["libdiag_headers"],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
}
