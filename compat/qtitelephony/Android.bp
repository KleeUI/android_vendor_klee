java_library {
    name: "QtiTelephonyCompat",
    srcs: ["src/**/*.java"],
    installable: true,
    platform_apis: true,
    system_ext_specific: true,
}

android_app {
    name: "QtiTelephonyBroadcastCompat",
    certificate: "platform",
    privileged: true,
    sdk_version: "current",
    system_ext_specific: true,
}
