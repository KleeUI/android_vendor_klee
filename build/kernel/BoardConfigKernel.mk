ifndef KLEE_KERNEL_BOARD_CONFIG_INCLUDED
KLEE_KERNEL_BOARD_CONFIG_INCLUDED := true

ifneq ($(strip $(TARGET_KERNEL_SOURCE)),)
KLEE_BUILD_KERNEL_FROM_SOURCE := true
KLEE_KERNEL_ARCH ?= $(TARGET_ARCH)
KLEE_KERNEL_IMAGE_NAME ?= $(BOARD_KERNEL_IMAGE_NAME)
ifeq ($(strip $(KLEE_KERNEL_IMAGE_NAME)),)
KLEE_KERNEL_IMAGE_NAME := Image
endif
KLEE_KERNEL_OUT ?= $(PRODUCT_OUT)/obj/KLEE_KERNEL
KLEE_KERNEL_DIST ?= $(PRODUCT_OUT)/obj/KLEE_KERNEL_DIST
KLEE_KERNEL_PLATFORM_PATH ?= $(TARGET_KERNEL_PLATFORM_PATH)
KLEE_KERNEL_BUILD_CONFIG := $(strip $(TARGET_KERNEL_BUILD_CONFIG))

ifeq ($(KLEE_SOURCE_DTB_REQUIRED),true)
KLEE_KERNEL_DTB_IMAGE ?= $(KLEE_KERNEL_DIST)/dtb.img
KLEE_KERNEL_SOURCE_DTB_ROOT ?= $(TARGET_KERNEL_SOURCE)/arch/$(KLEE_KERNEL_ARCH)/boot/dts/vendor
endif

KLEE_KERNEL_MODULES := $(sort $(KLEE_KERNEL_MODULES))
ifneq ($(KLEE_KERNEL_BUILD_CONFIG),)
ifeq ($(strip $(KLEE_KERNEL_PLATFORM_PATH)),)
$(error TARGET_KERNEL_PLATFORM_PATH must be set with TARGET_KERNEL_BUILD_CONFIG)
endif
KLEE_KERNEL_IMAGE := $(KLEE_KERNEL_DIST)/$(KLEE_KERNEL_IMAGE_NAME)
ifneq ($(KLEE_KERNEL_MODULES),)
KLEE_KERNEL_MODULE_PATHS := $(addprefix $(KLEE_KERNEL_DIST)/,$(KLEE_KERNEL_MODULES))
endif
else
KLEE_KERNEL_IMAGE := $(KLEE_KERNEL_OUT)/arch/$(KLEE_KERNEL_ARCH)/boot/$(KLEE_KERNEL_IMAGE_NAME)
ifneq ($(KLEE_KERNEL_MODULES),)
KLEE_KERNEL_MODULE_PATHS := $(addprefix $(KLEE_KERNEL_DIST)/modules/,$(KLEE_KERNEL_MODULES))
endif
ifneq ($(strip $(TARGET_KERNEL_DTB_BASES)),)
KLEE_KERNEL_DTB_IMAGE ?= $(KLEE_KERNEL_DIST)/dtb.img
endif
endif

ifeq ($(strip $(TARGET_PREBUILT_KERNEL)),)
TARGET_PREBUILT_KERNEL := $(KLEE_KERNEL_IMAGE)
endif

ifeq ($(TARGET_NEEDS_DTBOIMAGE),true)
KLEE_KERNEL_DTBO_TARGET ?= dtbo.img
ifneq ($(KLEE_KERNEL_BUILD_CONFIG),)
KLEE_KERNEL_DTBO_IMAGE ?= $(KLEE_KERNEL_DIST)/$(KLEE_KERNEL_DTBO_TARGET)
else
KLEE_KERNEL_DTBO_IMAGE ?= $(KLEE_KERNEL_OUT)/arch/$(KLEE_KERNEL_ARCH)/boot/$(KLEE_KERNEL_DTBO_TARGET)
endif
ifeq ($(strip $(BOARD_PREBUILT_DTBOIMAGE)),)
BOARD_PREBUILT_DTBOIMAGE := $(KLEE_KERNEL_DTBO_IMAGE)
endif
endif
endif

endif
